@ARTICLE{Shopon2021470,
	author = {Shopon, Md and Tumpa, Sanjida Nasreen and Bhatia, Yajurv and Kumar, K. N. Pavan and Gavrilova, Marina L.},
	title = {Biometric Systems De-Identification: Current Advancements and Future Directions},
	year = {2021},
	journal = {Journal of Cybersecurity and Privacy},
	volume = {1},

@inbook{doi:https://doi.org/10.1002/9781118274538.ch2,

publisher = {John Wiley & Sons, Ltd},
isbn = {9781118274538},
title = {Print Subjectivity, or the Case History},
booktitle = {Breaking the Book},
chapter = {2},
pages = {69-101},
doi = {https://doi.org/10.1002/9781118274538.ch2},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118274538.ch2},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781118274538.ch2},
year = {2015},
keywords = {bibliographic practice, case history, physical book, printed texts, Puritan experience narratives, sympathetic identification},
abstract = {Summary This chapter investigates the ways in which the unconscious became during the eighteenth-century structured by the bodily practices involved in manipulating printed texts, just as the unconscious might be structured by stopping in the street to pick up waste, or not. In particular, it discusses the modes of sympathetic identification that are later best expressed by “the case history” that first emerged as a genre around 1800. The authors who write Puritan experience narratives as well as their readers feel their spirits spatialized, but only with the emergence of a specific bibliographic practice: silent reading. The chapter focuses on how physical activities surrounding printed books, their covers and heft, for instance, inflect psychic reality. It examines how the emergence of the mass-printed case history is tied to the very physical form of the book as it is lived (lived with and lived in), the more that books abound.}
}
@inbook{doi:https://doi.org/10.1002/9781394266661.ch5,
author = {Perkins, Ria},
publisher = {John Wiley & Sons, Ltd},
isbn = {9781394266661},
title = {Other Language Influence Detection},
booktitle = {Methodologies and Challenges in Forensic Linguistic Casework},
chapter = {5},
pages = {63-76},
doi = {https://doi.org/10.1002/9781394266661.ch5},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394266661.ch5},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394266661.ch5},
year = {2022},
keywords = {language families, lexico-grammatical explanations, native language, Other Language Influence Detection, profiling, sociolinguistic features, web pedophile},
abstract = {Summary This chapter introduces the field of Other Language Influence Detection (OLID) and focuses on a sociolinguistic and OLID profiling case of an anonymous account holder, who was regularly posting on a dark web pedophile forum. There appears to be an increasing number of cases in which OLID has been used, at least to some extent; however, due to the often sensitive nature, these are seldom discussed in the academic literature. Likewise, all forensic linguistic profiling needs to be aware of the potential of disguise. Many of the features discussed are indicative of language families rather than specific languages within a particular family. When undertaking OLID analysis in casework, the focus is on marked language —language that is unusual or marked in some way and would not commonly be used by native English speakers. Features with lexico-grammatical explanations include those related to formulaic sequences, phrasal lexemes, collocations, and idioms.}
}@article{https://doi.org/10.1111/rssc.12258,
author = {Pigoli, Davide and Hadjipantelis, Pantelis Z. and Coleman, John S. and Aston, John A. D.},
title = {The statistical analysis of acoustic phonetic data: exploring differences between spoken Romance languages},
journal = {Journal of the Royal Statistical Society: Series C (Applied Statistics)},
volume = {67},
number = {5},
pages = {1103-1145},
keywords = {Functional data analysis, Object data, Quantitative linguistics, Spectrograms},
doi = {https://doi.org/10.1111/rssc.12258},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/rssc.12258},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1111/rssc.12258},
abstract = {Summary The historical and geographical spread from older to more modern languages has long been studied by examining textual changes and in terms of changes in phonetic transcriptions. However, it is more difficult to analyse language change from an acoustic point of view, although this is usually the dominant mode of transmission. We propose a novel analysis approach for acoustic phonetic data, where the aim will be to model the acoustic properties of spoken words statistically. We explore phonetic variation and change by using a time–frequency representation, namely the log-spectrograms of speech recordings. We identify time and frequency covariance functions as a feature of the language; in contrast, mean spectrograms depend mostly on the particular word that has been uttered. We build models for the mean and covariances (taking into account the restrictions placed on the statistical analysis of such objects) and use these to define a phonetic transformation that models how an individual speaker would sound in a different language, allowing the exploration of phonetic differences between languages. Finally, we map back these transformations to the domain of sound recordings, enabling us to listen to the output of the statistical analysis. The approach proposed is demonstrated by using recordings of the words corresponding to the numbers from 1 to 10 as pronounced by speakers from five different Romance languages.},
year = {2018}
}

